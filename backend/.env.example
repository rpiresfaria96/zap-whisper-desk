# Endereço do WPPConnect Server (não coloque /api no final)
WPP_BASE_URL=http://127.0.0.1:8787

# Nome da sessão criada no WPPConnect Server
WPP_SESSION=Ideal

# Token (campo `token` da resposta generate-token; NÃO use o campo `full`, pois a sessão já vai na URL)
WPP_TOKEN=

# Porta deste adaptador local
API_PORT=3001

# Origens locais autorizadas a acessar a API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
