# Endereço do WPPConnect Server (não coloque /api no final)
WPP_BASE_URL=http://127.0.0.1:8787

# Nome da sessão criada no WPPConnect Server
WPP_SESSION=minha-sessao

# Token da sessão (token bearer gerado pelo WPPConnect; não use o SECRET_KEY global)
WPP_TOKEN=cole-seu-token-aqui

# Porta deste adaptador local
API_PORT=3001

# Origens locais autorizadas a acessar a API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
