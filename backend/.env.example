# Endereço do WPPConnect Server deste projeto (não coloque /api no final)
WPP_BASE_URL=http://127.0.0.1:8788

# ID tecnico da sessao: WPPConnect nao aceita espacos no identificador.
WPP_SESSION=Ideal_Contabilidade

# Token gerado automaticamente por INICIAR.bat (scripts/configurar-sessao.ps1)
WPP_TOKEN=

# Porta deste adaptador local
API_PORT=3001

# Origens locais autorizadas a acessar a API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
